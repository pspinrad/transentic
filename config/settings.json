{
  "SENTIMENTS": ["Happy", "Sad", "Surprised", "Angry", "Fearful", "Disgusted"],
  "STYLINGS": [
    "R-text", "G-text", "B-text",
    "R-bkgnd", "G-bkgnd", "B-bkgnd",
    "Size", "Weight", "Underline",
    "Forward-slant", "Space-letters", "Crowd-letters", "Baseline-bounce"
  ],

  "min_font_size": 14,
  "max_font_size": 20,

  "min_font_weight": 400,
  "max_font_weight": 900,

  "min_underline_gray": 250,
  "max_underline_gray": 0,

  "max_forward_slant": 10,

  "min_letter_spacing_space_em": 0,
  "max_letter_spacing_space_em": 0.15,
  "max_wdth_space_delta": 51,

  "min_letter_spacing_crowd_em": 0,
  "max_letter_spacing_crowd_em": -0.03,
